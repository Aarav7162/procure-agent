# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox Account Emails
ORCHESTRATOR_PAYPAL_EMAIL=your_orchestrator@business.example.com
WORKER_PAYPAL_EMAIL=your_worker@personal.example.com

# LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Payout Mode: 'live' requires working PayPal Payouts enabled account; 'simulated' operates in sandbox with clear SIMULATED labeling
PAYOUT_MODE=simulated

# App Config
MAX_BUDGET_USD=15.00
ORCHESTRATOR_PORT=8000
BROKER_PORT=8001
OCR_WORKER_PORT=8002
SCRAPE_WORKER_PORT=8003
EMBED_WORKER_PORT=8004
ROGUE_WORKER_PORT=8005
