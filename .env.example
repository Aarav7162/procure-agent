# ==============================================================================
# ProcureAgent Environment Configuration (.env.example)
# ==============================================================================

# PayPal Sandbox API Credentials (OAuth2 & Payouts API v1)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Payout Mode: 'live' executes real PayPal Sandbox API payouts; 'simulated' operates offline
PAYOUT_MODE=live

# Dedicated Sandbox Accounts (Distinct email per worker required)
ORCHESTRATOR_PAYPAL_EMAIL=sb-s8vke53470365@business.example.com
WORKER_PAYPAL_EMAIL=sb-sqcdl53128062@personal.example.com
OCR_BETA_PAYPAL_EMAIL=sb-shusq53615721@personal.example.com
LLM_WORKER_PAYPAL_EMAIL=sb-kgyi653615592@personal.example.com
CODE_WORKER_PAYPAL_EMAIL=sb-bef9t53614820@personal.example.com
CODE_WORKER_20B_PAYPAL_EMAIL=sb-kgyi653615592@personal.example.com
ROGUE_PAYPAL_EMAIL=sb-a43fio53613334@personal.example.com

# LLM Providers & Models
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_20B=openai/gpt-oss-20b
JUDGE_MODEL=qwen/qwen3.8-27b

# Microservice Ports
ORCHESTRATOR_PORT=8000
BROKER_PORT=8001
OCR_WORKER_PORT=8002
CODE_WORKER_PORT=8003
LLM_WORKER_PORT=8004
ROGUE_WORKER_PORT=8005
OCR_BETA_PORT=8006
CODE_WORKER_20B_PORT=8007

# Treasury Budget Configuration
MAX_BUDGET_USD=15.00
COLD_START_CAP_USD=1.00
COLD_START_MIN_TASKS=3
